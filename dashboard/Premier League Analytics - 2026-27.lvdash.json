{
  "datasets": [
    {
      "name": "a1cc0811",
      "displayName": "League Standings",
      "queryLines": [
        "\n",
        "SELECT\n",
        "    position AS Pos,\n",
        "    team_name AS Team,\n",
        "    played AS P,\n",
        "    won AS W,\n",
        "    drawn AS D,\n",
        "    lost AS L,\n",
        "    goals_for AS GF,\n",
        "    goals_against AS GA,\n",
        "    goal_difference AS GD,\n",
        "    points AS Pts\n",
        "FROM workspace.default.gold_league_table\n",
        "ORDER BY position ASC;\n"
      ]
    },
    {
      "name": "83ed1baa",
      "displayName": "Season KPI's",
      "queryLines": [
        "SELECT\n",
        "    (SELECT COUNT(*)\n",
        "     FROM workspace.default.gold_league_table) AS total_teams,\n",
        "\n",
        "    (SELECT COUNT(*)\n",
        "     FROM workspace.default.silver_matches\n",
        "     WHERE match_status = 'FINISHED') AS matches_played,\n",
        "\n",
        "    (SELECT COALESCE(SUM(home_goals + away_goals), 0)\n",
        "     FROM workspace.default.silver_matches\n",
        "     WHERE match_status = 'FINISHED') AS total_goals;"
      ]
    },
    {
      "name": "c2d9ca51",
      "displayName": "Team Points",
      "queryLines": [
        "SELECT\n",
        "    team_name,\n",
        "    points\n",
        "FROM workspace.default.gold_league_table\n",
        "ORDER BY points DESC, team_name ASC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "4857275b",
      "displayName": "Top Goalscorers",
      "queryLines": [
        "SELECT\n",
        "    player_name,\n",
        "    team_name,\n",
        "    goals\n",
        "FROM workspace.default.gold_player_stats\n",
        "ORDER BY goals DESC, player_name ASC\n",
        "LIMIT 10;"
      ]
    }
  ],
